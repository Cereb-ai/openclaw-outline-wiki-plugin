{
  "name": "@cereb/outline-wiki-openclaw-plugin",
  "version": "0.5.1",
  "type": "module",
  "description": "OpenClaw native plugin for Outline Wiki knowledge base. 14 named tools (defineToolPlugin) — one per outline category.method. Replaces the 0.3.x single-dispatcher `outline_wiki` tool. (0.5.1: doc create validation plus CP-586 A2-A5 hardening)",
  "license": "MIT",
  "author": {
    "name": "Leo Wang",
    "email": "wanglingsong@gmail.com",
    "url": "https://github.com/LeoWangCereb"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Cereb-ai/openclaw-outline-wiki-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/Cereb-ai/openclaw-outline-wiki-plugin/issues"
  },
  "homepage": "https://github.com/Cereb-ai/openclaw-outline-wiki-plugin#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "outline-tool": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "outline",
    "wiki",
    "openclaw",
    "knowledge-base"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "openclaw": "latest",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
